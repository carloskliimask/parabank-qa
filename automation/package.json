{
  "name": "parabank-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI and Postman/Newman API checks for ParaBank",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test tests/ui",
    "test:api": "newman run ../postman/parabank-api.postman_collection.json --environment ../postman/parabank.postman_environment.json",
    "test:ui-mode": "playwright test --ui",
    "test:report": "allure serve allure-results",
    "test:report:generate": "allure generate allure-results --clean -o allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^20.17.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "3.3.0",
    "newman": "^6.2.2",
    "typescript": "5.9.3"
  }
}
